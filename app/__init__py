# app/__init__.py

import os
from flask import Flask
from dotenv import load_dotenv

# Importa o objeto 'db' do nosso arquivo de modelos
from .models import db

def create_app():
    """Cria e configura uma instância da aplicação Flask."""
    app = Flask(__name__)
    load_dotenv() # Carrega as variáveis do arquivo .env

    # --- Configuração ---
    # Usa a DATABASE_URL do Render ou um SQLite local para desenvolvimento
    db_url = os.environ.get("DATABASE_URL")
    if db_url:
        # Corrige o dialeto da URL para o SQLAlchemy
        app.config['SQLALCHEMY_DATABASE_URI'] = db_url.replace("postgres://", "postgresql://", 1)
    else:
        # Se estiver rodando local, usa um banco de dados de arquivo
        app.config['SQLALCHEMY_DATABASE_URI'] = 'sqlite:///conversations.db'
    
    app.config['SQLALCHEMY_TRACK_MODIFICATIONS'] = False

    # --- Inicialização das Extensões ---
    # Conecta nossa instância 'db' com a aplicação Flask
    db.init_app(app)

    # --- Registro das Rotas (Blueprint) ---
    from .routes import main_bp
    app.register_blueprint(main_bp)

    return app